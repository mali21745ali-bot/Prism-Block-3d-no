{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated player account, preferences, progress summary, wallet balances, verification details, and withdrawal security PIN hash.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID matching document ID." },
        "displayName": { "type": "string", "description": "Player display name." },
        "email": { "type": "string", "description": "Private player email address." },
        "photoUrl": { "type": "string", "description": "Optional profile avatar URL." },
        "blocked": { "type": "boolean", "description": "Admin moderation flag blocking blocked players from actions." },
        "selectedThemeId": { "type": "string", "description": "Active 3D board theme ID." },
        "unlockedThemeIds": { "type": "array", "description": "Bounded list of unlocked theme IDs." },
        "classicHighScore": { "type": "integer", "description": "Highest Classic mode score." },
        "totalLinesCleared": { "type": "integer", "description": "Lifetime cleared lines." },
        "totalGamesPlayed": { "type": "integer", "description": "Lifetime played sessions." },
        "currentLevel": { "type": "integer", "description": "Current active Level Mode stage (1..100)." },
        "currentLevelLines": { "type": "integer", "description": "Lines cleared toward current level (0..1000)." },
        "completedLevelsCount": { "type": "integer", "description": "Total completed levels (0..100)." },
        "dailyRewardNextDay": { "type": "integer", "description": "Next unclaimed daily reward day (1..7); never resets on missed days." },
        "dailyRewardLastClaimDate": { "type": "string", "description": "UTC date string YYYY-MM-DD of last daily login reward claim." },
        "dailyChallengeLastDate": { "type": "string", "description": "UTC date string YYYY-MM-DD of latest daily challenge run." },
        "dailyChallengeBestScore": { "type": "integer", "description": "Best score achieved in today's daily challenge." },
        "mainWalletPkrPaisa": { "type": "integer", "description": "Main Wallet balance in PKR paisa (100 paisa = 1.00 PKR)." },
        "purchasedCoins": { "type": "integer", "description": "Purchased Coin balance tracked separately for compliance." },
        "earnedCoins": { "type": "integer", "description": "Promotional and gameplay earned Coin balance." },
        "walletVerificationName": { "type": "string", "description": "Submitted full name for payout details." },
        "walletVerificationProvider": { "type": "string", "enum": ["", "JAZZCASH", "EASYPAISA"] },
        "walletVerificationAccount": { "type": "string", "description": "Submitted JazzCash or Easypaisa account number." },
        "walletVerificationCompleted": { "type": "boolean", "description": "Indicates wallet details form has been submitted." },
        "withdrawalPinHash": { "type": "string", "description": "Salted SHA-256 hash of user's withdrawal password." },
        "withdrawalPinSalt": { "type": "string", "description": "Random salt for withdrawal password hash." },
        "musicEnabled": { "type": "boolean", "description": "Background music toggle." },
        "sfxEnabled": { "type": "boolean", "description": "Sound effects toggle." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of account creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update." }
      },
      "required": [
        "userId", "displayName", "email", "photoUrl", "blocked", "selectedThemeId",
        "unlockedThemeIds", "classicHighScore", "totalLinesCleared", "totalGamesPlayed",
        "currentLevel", "currentLevelLines", "completedLevelsCount", "dailyRewardNextDay",
        "dailyRewardLastClaimDate", "dailyChallengeLastDate", "dailyChallengeBestScore",
        "mainWalletPkrPaisa", "purchasedCoins", "earnedCoins", "walletVerificationName",
        "walletVerificationProvider", "walletVerificationAccount", "walletVerificationCompleted",
        "withdrawalPinHash", "withdrawalPinSalt", "musicEnabled", "sfxEnabled", "createdAt", "updatedAt"
      ]
    },
    "LevelProgress": {
      "title": "LevelProgress",
      "description": "Per-player, per-level progress record tracking cleared lines, required target lines, best score, attempts, star rating, and completion status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "levelNumber": { "type": "integer", "description": "Level stage number (1..100)." },
        "linesCleared": { "type": "integer", "description": "Lines cleared on this level (0..requiredLines)." },
        "requiredLines": { "type": "integer", "description": "Lines required to complete this level (1..10000)." },
        "bestScore": { "type": "integer", "description": "Highest score achieved while playing this level." },
        "attemptsCount": { "type": "integer", "description": "Total play attempts recorded on this level." },
        "starsEarned": { "type": "integer", "description": "Star rating earned (0..3)." },
        "completed": { "type": "boolean", "description": "Whether the player has completed this level." },
        "completedAt": { "type": "string", "format": "date-time", "description": "Optional server timestamp set once when completed transitions to true." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when level progress record was created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of latest update." }
      },
      "required": [
        "userId", "levelNumber", "linesCleared", "requiredLines", "bestScore",
        "attemptsCount", "starsEarned", "completed", "createdAt", "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
