        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "displayName", "role", "active", "permissions", "grantedBy", "createdAt", "updatedAt"]
    },
